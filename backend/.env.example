# Database
DATABASE_URL=postgresql+asyncpg://postgres:Welcome%402026@localhost:5532/chatbot

# Groq API — LLM / answer generation (free - get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# Google Gemini API — embeddings (free - get yours at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# App Settings
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
