# Database
DATABASE_URL=postgresql+asyncpg://postgres:Welcome%402026@localhost:5532/chatbot

# Google Gemini API — LLM + embeddings (free - get yours at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# App Settings
APP_ENV=development
# Comma-separated list of allowed frontend origins (add your production URL here)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional — used by Render/Railway (defaults to 8000 locally)
# PORT=8000

# Auth — set a long random secret in production
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
